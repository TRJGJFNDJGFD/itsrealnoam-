# These are read by the Netlify Functions in netlify/functions/ (the status
# API), not by the website's Vite bundle — nothing here ever reaches the
# browser. In production, set them in Netlify's dashboard under
# Site configuration -> Environment variables. For local dev, copy this file
# to ".env" at the repo root and run `netlify dev` (not `npm run dev`) so the
# functions pick them up.

# Shared secret the Velocity plugin must send as "Authorization: Bearer <token>"
# when it POSTs to /api/v1/heartbeat. Generate a long random value, e.g.
# `openssl rand -hex 32`. Never commit the real value.
STATUS_API_TOKEN=change-me

# Comma-separated list of extra origins allowed to read GET /api/v1/status
# from a browser. The site's own frontend doesn't need this (same origin) —
# only set it if some other site should also be able to read your status
# endpoint. Leave empty/unset otherwise.
WEBSITE_ORIGIN=

# If no heartbeat has been received within this many milliseconds, the
# network is reported as offline/stale instead of serving old numbers as live.
STALE_AFTER_MS=15000
